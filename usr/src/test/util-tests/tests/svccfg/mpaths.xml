<service_bundle type='manifest' name='mpathstest'>

<service name='test/mpaths' type='service' version='1'>

	<method_context>
		<method_credential user='daemon' group='sys' />
	</method_context>

	<managed_paths>
		<directory path='/var/run/mpaths' empty='true' />
		<directory path='/var/run/mpaths/sub' user='root'
		    group='root' mode='0700' />
	</managed_paths>

	<managed_paths>
		<directory path='/var/tmp/mpaths-%i' env='MPATHS_DIR' />
	</managed_paths>

	<exec_method type='method' name='start' exec=':true'
	    timeout_seconds='0' />
	<exec_method type='method' name='stop' exec=':true'
	    timeout_seconds='0' />

	<instance name='default' enabled='false'>
		<managed_paths>
			<directory path='/var/tmp/mpaths-inst'
			    env='MPATHS_DIR' />
		</managed_paths>
	</instance>

</service>

</service_bundle>
